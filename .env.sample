# naturedb origin the client calls. Empty = same origin: the Vite proxy (dev) or the
# nginx proxy (prod) forwards /api, /admin, /static, /specimens to naturedb.
# Set it only to call naturedb cross-origin (needs naturedb CORS_ALLOWED_ORIGINS + JWT_COOKIE_DOMAIN).
VITE_NATUREDB_BASE=

# dev only: where the Vite proxy forwards, and the Host header naturedb resolves its site from
NATUREDB_PROXY_TARGET=http://flask:5000
NATUREDB_SITE_HOST=hast.localhost:5000

# prod only (compose.prod.yml)
GREENHOUSE_HOST=begonia.naturedb.org
NATUREDB_UPSTREAM=naturedb-flask-prod-container:8001
NATUREDB_UPSTREAM_HOST=hast.biodiv.tw
