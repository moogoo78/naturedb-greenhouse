# naturedb origin the client calls. Empty = same origin (dev, via the Vite proxy).
# prod: https://hast.biodiv.tw  (naturedb needs CORS_ALLOWED_ORIGINS=<this client's origin>
#       and JWT_COOKIE_DOMAIN=.biodiv.tw so the login cookie reaches both hosts)
VITE_NATUREDB_BASE=

# dev only: where the Vite proxy forwards, and the Host header naturedb resolves its site from
NATUREDB_PROXY_TARGET=http://flask:5000
NATUREDB_SITE_HOST=hast.localhost:5000
